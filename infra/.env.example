# Sahara/Intron is optional for transcript-only demo flows and required for live audio.
SAHARA_API_KEY=

# Local Compose defaults. Change these together if your machine already uses the ports.
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegis
POSTGRES_PORT=5432
BACKEND_PORT=8000

# Comma-separated browser origins allowed to call the backend.
ALLOWED_ORIGINS=http://localhost:3000

# Used by host-run backend processes. Compose supplies its own db-host URL.
DATABASE_URL=postgresql+psycopg2://aegis:aegis@localhost:5432/aegis
BANKING_API_MODE=mock
